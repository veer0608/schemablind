# Keys. Never.
.env

# BIRD ships gigabytes of databases; they are downloaded, not committed.
/data/
/bird/
dev_databases/
mini_dev_databases/
*.zip

# ...except the toy database, which is generated from tests/conftest.py and is
# small enough to be worth having in the repo so the harness runs on a clone.
!evals/toy/databases/**/*.sqlite

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Eval output: scorecards, checkpoints and logs from real runs. Reproducible
# from the runner, specific to one key's daily budget, and large. The numbers
# worth keeping go in the README, not here.
/runs/
